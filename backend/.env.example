PORT=4300
DATABASE_URL=postgresql://invoice_ocr:invoice_ocr@localhost:5434/invoice_ocr?schema=public

# ─── Invoice extraction ───────────────────────────────────────────────────
# 'direct' (default): Mistral OCR + an LLM, called from this API.
# 'n8n': the old workflow (fallback only; uses the N8N_* vars below).
INVOICE_EXTRACTOR=direct
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest
# Any OpenAI-compatible chat API; LLM_API_KEY falls back to MISTRAL_API_KEY.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL_FAST=mistral-medium-latest
AI_TIMEOUT_MS=90000
# Handwritten invoices ("handwritten" ticked on upload) are read from the photo
# by a separate vision model: Mistral can't read Persian handwriting. Any
# OpenAI-compatible API; Gemini by default (key: https://aistudio.google.com/apikey).
# Without VISION_API_KEY they go to the LLM above.
VISION_API_KEY=
VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VISION_MODEL=gemini-3.5-flash
VISION_REASONING_EFFORT=none
VISION_TIMEOUT_MS=45000
N8N_BASE_URL=http://localhost:5678
N8N_EXTRACT_PATH=/webhook/invoice-ocr-mistral
# ─── Accounting systems ───────────────────────────────────────────────────
# Where checked purchase invoices are sent (Settings → Accounting system).
# ASR partner API: the key comes from ASR; keep it on the server only. The
# address is plain HTTP for now, so call it only from a trusted network.
ASR_BASE_URL=
ASR_API_KEY=
ASR_TIMEOUT_MS=30000

# ─── Raw-material pricing ─────────────────────────────────────────────────
# Matching materials to price-index categories (Settings → Material matching).
# "LLM" uses the LLM_* settings above. "Jev" and "Jev, then LLM" need TypeSafe's
# Jev: JEV_BASE_URL is the app URL from TypeSafe's app page.
JEV_BASE_URL=
JEV_API_KEY=
JEV_MODEL=jev/jev-latest
JEV_TIMEOUT_MS=15000
# "Jev, then LLM": Jev answers below this confidence are checked by the LLM.
MATCHER_COMBINED_MIN_CONFIDENCE=0.7

CORS_ORIGIN=http://localhost:5173
JWT_SECRET=dev-only-insecure-secret-change-me
# Optional — without it, mileage distance must be entered manually (from/to → distance calculation is disabled, not the app).
GOOGLE_DIRECTIONS_API_KEY=

# ─── File storage ─────────────────────────────────────────────────────────
# 'local' (default) or 's3'. Only UPLOADS_DIR is used for 'local'; only the
# S3_* vars are used for 's3' — no need to fill in both.
FILE_STORAGE_PROVIDER=local
UPLOADS_DIR=./uploads

# S3-compatible storage (used only when FILE_STORAGE_PROVIDER=s3). Works with
# real AWS S3 (leave S3_ENDPOINT blank) or any S3-compatible bucket — e.g.
# Cloudflare R2 (S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com),
# a self-hosted MinIO, etc. Files stay private — nothing here is served via a
# public bucket URL, everything goes through this app's own authenticated
# /api/expenses/:id/file route.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
