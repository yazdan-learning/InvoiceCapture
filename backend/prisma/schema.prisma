generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users      User[]
  invoices   Invoice[]
  categories Category[]
}

enum Role {
  EMPLOYEE
  APPROVER
  ADMIN
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email        String @unique
  name         String
  passwordHash String
  role         Role   @default(EMPLOYEE)

  // Approval routing lives here, not in a separate config table: your approver
  // is your manager. Multi-step/conditional rules later build on this same chain.
  managerId String?
  manager   User?   @relation("ManagerHierarchy", fields: [managerId], references: [id])
  reports   User[]  @relation("ManagerHierarchy")

  createdAt DateTime @default(now())

  invoices  Invoice[]
  approvals Approval[]
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String
  createdAt DateTime @default(now())

  invoices Invoice[]

  @@unique([organizationId, name])
}

enum InvoiceStatus {
  PENDING // uploaded, not yet processed
  PROCESSING
  EXTRACTED // OCR/AI succeeded, awaiting human review
  FAILED
  REVIEWED // human confirmed the data
  SUBMITTED // sent to the submitter's manager for approval
  APPROVED
  REJECTED // sent back to the submitter, editable and re-submittable
}

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  uploadedBy String
  uploader   User   @relation(fields: [uploadedBy], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  filePath  String
  mimeType  String
  fileSizeB Int
  status    InvoiceStatus @default(PENDING)

  invoiceNumber   String?
  invoiceDate     DateTime?
  dueDate         DateTime?
  vendorName      String?
  vendorAddress   String?
  vendorTaxId     String?
  customerName    String?
  customerAddress String?

  subtotal      Decimal? @db.Decimal(12, 2)
  taxRate       Decimal? @db.Decimal(5, 2)
  taxAmount     Decimal? @db.Decimal(12, 2)
  totalAmount   Decimal? @db.Decimal(12, 2)
  currency      String?
  paymentMethod String?
  paymentTerms  String?
  notes         String?

  isDuplicate  Boolean @default(false)
  duplicateOfId String?

  rawExtraction Json?
  errorMessage  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     InvoiceLineItem[]
  approvals Approval[]

  @@index([organizationId, status])
  @@index([organizationId, vendorName, invoiceNumber])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

// One row per submission. v1 only ever creates stepOrder 1 (single approver =
// the submitter's manager); multi-step later means more rows per submission,
// not a schema change. Rejections create a fresh row on re-submission, so the
// full history stays visible via createdAt.
model Approval {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation(fields: [approverId], references: [id])

  stepOrder Int              @default(1)
  decision  ApprovalDecision @default(PENDING)
  comment   String?
  decidedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([invoiceId])
  @@index([approverId, decision])
}

model InvoiceLineItem {
  id        String  @id @default(uuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal? @db.Decimal(12, 3)
  unitPrice   Decimal? @db.Decimal(12, 2)
  totalPrice  Decimal? @db.Decimal(12, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
}
