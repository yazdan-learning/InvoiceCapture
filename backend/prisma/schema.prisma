generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Reimbursement rate is company policy, not something an employee types in
  // per trip — see mileage creation logic. Single flat rate for v1 (no
  // per-vehicle-type or per-country tiers yet).
  mileageRatePerKm Decimal @default(0.30) @db.Decimal(6, 3)

  // Extracted receipts get auto-converted into this currency; mileage
  // reimbursement is implicitly denominated in it too (no conversion needed
  // there — the rate above is already set in whatever currency this is).
  defaultCurrency String @default("EUR")

  // Fallback UI language for anyone who hasn't picked their own (stored in
  // the browser, not here) — see SUPPORTED_LANGUAGES in backend/src/shared/languages.ts.
  defaultLanguage String @default("en")

  users      User[]
  expenses   Expense[]
  categories Category[]
}

enum Role {
  EMPLOYEE
  APPROVER
  ADMIN
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email        String @unique
  name         String
  passwordHash String
  role         Role   @default(EMPLOYEE)

  // Approval routing lives here, not in a separate config table: your approver
  // is your manager. Multi-step/conditional rules later build on this same chain.
  managerId String?
  manager   User?   @relation("ManagerHierarchy", fields: [managerId], references: [id])
  reports   User[]  @relation("ManagerHierarchy")

  createdAt DateTime @default(now())

  expenses  Expense[]
  approvals Approval[]
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String
  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([organizationId, name])
}

enum ExpenseStatus {
  PENDING // uploaded, not yet processed
  PROCESSING
  EXTRACTED // OCR/AI succeeded, awaiting human review
  FAILED
  SUBMITTED // sent to the submitter's manager for approval
  APPROVED
  REJECTED // sent back to the submitter, editable and re-submittable
}

// RECEIPT is the only type v1 actually supports end to end (document capture
// + OCR). MILEAGE/PER_DIEM/GENERAL are reserved here so adding them later is
// a matter of using the field, not migrating the schema again — the vendor/
// document fields below are already nullable for exactly this reason.
enum ExpenseType {
  RECEIPT
  MILEAGE
  PER_DIEM
  GENERAL
}

model Expense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  uploadedBy String
  uploader   User   @relation(fields: [uploadedBy], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  expenseType ExpenseType   @default(RECEIPT)
  status      ExpenseStatus @default(PENDING)

  // Document capture — only populated for RECEIPT-type expenses.
  filePath  String?
  mimeType  String?
  fileSizeB Int?

  invoiceNumber   String?
  invoiceDate     DateTime?
  dueDate         DateTime?
  vendorName      String?
  vendorAddress   String?
  vendorTaxId     String?
  customerName    String?
  customerAddress String?

  subtotal      Decimal? @db.Decimal(12, 2)
  taxRate       Decimal? @db.Decimal(5, 2)
  taxAmount     Decimal? @db.Decimal(12, 2)
  totalAmount   Decimal? @db.Decimal(12, 2)
  currency      String?
  paymentMethod String?
  paymentTerms  String?
  notes         String?

  // Snapshot of what was actually on the invoice before any currency
  // conversion — written once at extraction time, never touched by later
  // edits. subtotal/taxAmount/totalAmount above become the converted
  // (org.defaultCurrency) values when conversion happens; these three plus
  // originalCurrency are what "revert to the original" restores. taxRate is a
  // percentage, not a money figure, so it doesn't need an original either.
  originalCurrency    String?
  originalSubtotal    Decimal? @db.Decimal(12, 2)
  originalTaxAmount   Decimal? @db.Decimal(12, 2)
  originalTotalAmount Decimal? @db.Decimal(12, 2)
  exchangeRate        Decimal? @db.Decimal(12, 6)
  exchangeRateDate    DateTime?

  isDuplicate   Boolean @default(false)
  duplicateOfId String?

  rawExtraction Json?
  errorMessage  String?

  // Mileage — only populated for MILEAGE-type expenses. mileageDistanceKm is
  // always the one-way distance; totalAmount is always server-derived from
  // distance × (roundTrip ? 2 : 1) × Organization.mileageRatePerKm, never
  // taken from the client, so the rate can't be gamed per-entry.
  mileageDate       DateTime?
  mileageFrom       String?
  mileageTo         String?
  mileageDistanceKm Decimal?  @db.Decimal(8, 2)
  mileageRoundTrip  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     ExpenseLineItem[]
  approvals Approval[]

  @@index([organizationId, status])
  @@index([organizationId, vendorName, invoiceNumber])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

// One row per submission. v1 only ever creates stepOrder 1 (single approver =
// the submitter's manager); multi-step later means more rows per submission,
// not a schema change. Rejections create a fresh row on re-submission, so the
// full history stays visible via createdAt.
model Approval {
  id        String  @id @default(uuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation(fields: [approverId], references: [id])

  stepOrder Int              @default(1)
  decision  ApprovalDecision @default(PENDING)
  comment   String?
  decidedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([expenseId])
  @@index([approverId, decision])
}

model ExpenseLineItem {
  id        String  @id @default(uuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal? @db.Decimal(12, 3)
  unitPrice   Decimal? @db.Decimal(12, 2)
  totalPrice  Decimal? @db.Decimal(12, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
}
