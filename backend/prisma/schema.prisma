generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  // Reimbursement rate is company policy, not something an employee types in
  // per trip — see mileage creation logic. Single flat rate for v1 (no
  // per-vehicle-type or per-country tiers yet).
  mileageRatePerKm Decimal @default(0.30) @db.Decimal(14, 3)

  // Extracted receipts get auto-converted into this currency; mileage
  // reimbursement is implicitly denominated in it too (no conversion needed
  // there — the rate above is already set in whatever currency this is).
  defaultCurrency String @default("EUR")

  // Fallback UI language for anyone who hasn't picked their own (stored in
  // the browser, not here) — see SUPPORTED_LANGUAGES in backend/src/shared/languages.ts.
  defaultLanguage String @default("en")

  // Which country profile applies: calendar, extra currencies and how invoices
  // are read — see backend/src/countries/registry.ts. "INTL" = no country-specific rules.
  country String @default("INTL")

  // What the organization uses the app for (Settings → Modules): employee
  // expenses, purchase invoices captured by the accountant, or both. At least one.
  modules AppModule[] @default([EXPENSES])

  // Where checked purchase invoices are sent — see backend/src/accounting/registry.ts.
  // "NONE" = no accounting system connected: sending only marks them as sent.
  accountingConnector String @default("NONE")

  // Where exchange rates come from (receipts, material pricing) — see
  // backend/src/currency/registry.ts.
  currencyConverter String @default("FRANKFURTER")

  // Which AI matches raw materials to price-index categories (LLM, JEV, or
  // both) — see backend/src/pricing/matchers/registry.ts.
  materialMatcher String @default("LLM")

  // How uploaded invoices are read (CLASSIC = the stable extractor; TEMPLATE =
  // the template-guided reader, which also shows on the photo where each field
  // was read) — see backend/src/reading/registry.ts. Switching back is this setting only.
  invoiceReader String @default("CLASSIC")

  // Invoice templates this organization builds are shared with every other
  // organization (layout only: where each field is, never values or images).
  shareTemplates Boolean @default(true)

  users       User[]
  invoiceTemplates InvoiceTemplate[]
  expenses     Expense[]
  categories   Category[]
  rawMaterials RawMaterial[]
}

enum AppModule {
  EXPENSES // employees' receipts and mileage, approved by their manager, reimbursed
  PURCHASE_INVOICES // supplier invoices, checked by the accountant and sent to the accounting system
  RAW_MATERIAL_PRICING // raw-material prices kept up to date from a price index and the exchange rate
}

enum Role {
  EMPLOYEE
  APPROVER
  ACCOUNTANT // captures and sends the organization's purchase invoices; no user or settings access
  ADMIN
}

model User {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  email        String @unique
  name         String
  passwordHash String
  role         Role   @default(EMPLOYEE)

  // Soft delete: deactivated users can't log in, but stay in place so
  // historical Expense.uploadedBy / Approval.approverId / manager chains
  // keep resolving correctly. "Delete user" in the UI sets this false.
  active Boolean @default(true)

  // Approval routing lives here, not in a separate config table: your approver
  // is your manager. Multi-step/conditional rules later build on this same chain.
  managerId String?
  manager   User?   @relation("ManagerHierarchy", fields: [managerId], references: [id])
  reports   User[]  @relation("ManagerHierarchy")

  createdAt DateTime @default(now())

  expenses  Expense[]
  approvals Approval[]
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name      String
  createdAt DateTime @default(now())

  expenses Expense[]

  @@unique([organizationId, name])
}

enum ExpenseStatus {
  PENDING // uploaded, not yet processed
  PROCESSING
  EXTRACTED // OCR/AI succeeded, awaiting human review
  FAILED
  SUBMITTED // sent to the submitter's manager for approval
  APPROVED
  REJECTED // sent back to the submitter, editable and re-submittable
  SENT // purchase invoice handed to the accounting system (no approval step)
}

// RECEIPT and MILEAGE are employee expenses; PURCHASE_INVOICE is a supplier
// invoice (the PURCHASE_INVOICES module) — same capture, extraction and review,
// but sent to accounting instead of approved. PER_DIEM/GENERAL are reserved
// here so adding them later is a matter of using the field, not migrating the
// schema again — the vendor/document fields below are already nullable for
// exactly this reason.
enum ExpenseType {
  RECEIPT
  MILEAGE
  PER_DIEM
  GENERAL
  PURCHASE_INVOICE
}

model Expense {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  uploadedBy String
  uploader   User   @relation(fields: [uploadedBy], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  expenseType ExpenseType   @default(RECEIPT)
  status      ExpenseStatus @default(PENDING)

  // Document capture — only populated for RECEIPT-type expenses.
  filePath  String?
  mimeType  String?
  fileSizeB Int?

  invoiceNumber   String?
  invoiceDate     DateTime?
  dueDate         DateTime?
  vendorName      String?
  vendorAddress   String?
  vendorTaxId     String?
  customerName    String?
  customerAddress String?

  subtotal      Decimal? @db.Decimal(18, 2)
  // Discount on the whole invoice (تخفیف), as a positive amount: subtotal is
  // before it, totalAmount after it.
  discountAmount Decimal? @db.Decimal(18, 2)
  taxRate       Decimal? @db.Decimal(5, 2)
  taxAmount     Decimal? @db.Decimal(18, 2)
  totalAmount   Decimal? @db.Decimal(18, 2)
  currency      String?
  paymentMethod String?
  paymentTerms  String?
  notes         String?

  // Snapshot of what was actually on the invoice before any currency
  // conversion — written once at extraction time, never touched by later
  // edits. subtotal/discountAmount/taxAmount/totalAmount above become the converted
  // (org.defaultCurrency) values when conversion happens; these four plus
  // originalCurrency are what "revert to the original" restores. taxRate is a
  // percentage, not a money figure, so it doesn't need an original either.
  // Money columns are Decimal(18, 2) and the rate (24, 12): Rial amounts run
  // into the billions, and a rate like IRR → EUR is 0.0000005.
  originalCurrency    String?
  originalSubtotal    Decimal? @db.Decimal(18, 2)
  originalDiscountAmount Decimal? @db.Decimal(18, 2)
  originalTaxAmount   Decimal? @db.Decimal(18, 2)
  originalTotalAmount Decimal? @db.Decimal(18, 2)
  exchangeRate        Decimal? @db.Decimal(24, 12)
  exchangeRateDate    DateTime?

  isDuplicate   Boolean @default(false)
  duplicateOfId String?

  rawExtraction Json?
  errorMessage  String?
  // What the AI read, as saved at upload (stored units, before currency
  // conversion) and never touched by later edits: compared with the final
  // values it shows what the user corrected (evaluation, template learning).
  initialReading Json?
  // When the field boxes were located on the page images (even if none were
  // found), so they are looked for only once.
  boxesLocatedAt DateTime?

  // Purchase invoices only: when it went to the accounting system, the id it
  // got there (if the connector returns one), and why the last attempt failed.
  sentToAccountingAt DateTime?
  accountingRef      String?
  accountingError    String?

  // Mileage — only populated for MILEAGE-type expenses. mileageDistanceKm is
  // always the one-way distance; totalAmount is always server-derived from
  // distance × (roundTrip ? 2 : 1) × Organization.mileageRatePerKm, never
  // taken from the client, so the rate can't be gamed per-entry.
  mileageDate       DateTime?
  mileageFrom       String?
  mileageTo         String?
  mileageDistanceKm Decimal?  @db.Decimal(8, 2)
  mileageRoundTrip  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      ExpenseLineItem[]
  approvals  Approval[]
  fieldBoxes ExpenseFieldBox[]

  // The invoice template whose boxes were used when the review page first
  // opened it (template-guided reader); on send, it learns from this invoice.
  templateId String?
  template   InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Fields whose box the user removed on this invoice ("Remove"): on send they are dropped from its
  // vendor's template too. Drawing a box for the field again takes it off this list.
  removedBoxFields String[] @default([])

  @@index([organizationId, status])
  @@index([organizationId, vendorName, invoiceNumber])
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

// One row per submission. v1 only ever creates stepOrder 1 (single approver =
// the submitter's manager); multi-step later means more rows per submission,
// not a schema change. Rejections create a fresh row on re-submission, so the
// full history stays visible via createdAt.
model Approval {
  id        String  @id @default(uuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  approverId String
  approver   User   @relation(fields: [approverId], references: [id])

  stepOrder Int              @default(1)
  decision  ApprovalDecision @default(PENDING)
  comment   String?
  decidedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([expenseId])
  @@index([approverId, decision])
}

model ExpenseLineItem {
  id        String  @id @default(uuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  description String
  quantity    Decimal? @db.Decimal(12, 3)
  unitPrice   Decimal? @db.Decimal(18, 2)
  totalPrice  Decimal? @db.Decimal(18, 2)
  taxRate     Decimal? @db.Decimal(5, 2)
  sortOrder   Int      @default(0)
}

enum FieldBoxSource {
  MODEL // located on the reading's values: word positions, or the vision model
  USER // drawn, moved or resized by the user (value: what was read from it, if anything)
  TEMPLATE // placed from the invoice template matched to this vendor/form
}

// Where on the document a field was read: a box on one page image (see
// backend/src/reading/page-images.ts), in 0–1 fractions of the page's width and
// height. One per field and source; field is a form field ("invoiceNumber",
// "totalAmount") or a line item ("items.2").
model ExpenseFieldBox {
  id        String         @id @default(uuid())
  expenseId String
  expense   Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  field     String
  source    FieldBoxSource
  page      Int
  x         Float
  y         Float
  width     Float
  height    Float
  // For USER boxes: what was read from the region.
  value     String?
  createdAt DateTime       @default(now())

  @@unique([expenseId, field, source])
}

// ─── Raw-material pricing (RAW_MATERIAL_PRICING module) ─────────────────────

enum MaterialMatchStatus {
  NEEDS_REVIEW // the AI suggested a category (or failed); a person hasn't confirmed it
  CONFIRMED // seriesId is the category its price follows
  NO_INDEX // confirmed: no index fits (e.g. transport), its price is kept by hand
}

// A raw material as named in the company's ERP. Its price follows one
// price-index series (seriesId, confirmed by a person) and the exchange rate.
// The AI's suggestion is kept apart (suggested*): renaming a material asks the
// AI again, but the price keeps following the confirmed series until a person
// accepts the new suggestion — a silent re-match would quietly change prices.
model RawMaterial {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name String
  unit String?

  // The last approved price and the day it applied: the next proposal is
  // computed from here. Starts as the price the material was added with.
  currency         String
  currentPrice     Decimal  @db.Decimal(18, 2)
  currentPriceDate DateTime

  matchStatus MaterialMatchStatus @default(NEEDS_REVIEW)
  seriesId    String?

  suggestedSeriesId    String?
  suggestionConfidence Decimal? @db.Decimal(5, 4)
  suggestionReason     String?
  suggestedBy          String? // "LLM", "JEV", "JEV+LLM", or "CONFIRMED" (reused from a confirmed material of the same name)
  matchError           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals MaterialPriceProposal[]

  @@unique([organizationId, name])
}

enum PriceProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

// A new price computed from the index and the exchange rate, waiting for a
// person: newPrice = previousPrice × indexRatio × fxRatio. At most one PENDING
// per material (a later run replaces it).
model MaterialPriceProposal {
  id         String      @id @default(uuid())
  materialId String
  material   RawMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  seriesId      String
  previousPrice Decimal  @db.Decimal(18, 2)
  previousDate  DateTime
  proposedPrice Decimal  @db.Decimal(18, 2)
  asOf          DateTime

  indexFrom   Decimal @db.Decimal(14, 4)
  indexTo     Decimal @db.Decimal(14, 4)
  indexPeriod String // the "YYYY-MM" of indexTo
  fxFrom      Decimal @db.Decimal(24, 12)
  fxTo        Decimal @db.Decimal(24, 12)

  status    PriceProposalStatus @default(PENDING)
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime            @default(now())

  @@index([materialId, status])
}

// Where a vendor's (or a form's) fields are on the page, learned when an
// invoice is sent (or submitted) and used to place the boxes on the next one —
// also for other organizations (shared): it holds the layout only, never a
// value, a name other than the vendor's, or a page image.
model InvoiceTemplate {
  id             String       @id @default(uuid())
  // The organization that built it (its own copy is preferred over shared ones).
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shared         Boolean      @default(true)

  // How it is found: the vendor's tax ID (digits) or its name, normalized.
  vendorTaxId String?
  vendorKey   String?
  vendorName  String?

  // Height ÷ width of each page it uses: a page of another shape is another form.
  pageAspects Json
  // { [field]: { page, x, y, width, height } } in 0–1 page fractions.
  fields      Json
  // The line-items table: { page, x, y, width, height, rowHeight } (rows from its top), or null.
  items       Json?

  // Trust: invoices sent with it, and how many of those needed its boxes moved.
  timesSent      Int @default(0)
  timesCorrected Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([vendorTaxId])
  @@index([vendorKey])
}
